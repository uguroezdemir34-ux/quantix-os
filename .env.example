# ╔══════════════════════════════════════════════════════════════════╗
# ║           QUANTIX OS — DEPLOYMENT ENVIRONMENT TEMPLATE          ║
# ║                                                                  ║
# ║  Kullanım:                                                       ║
# ║    cp .env.example .env.local                                    ║
# ║    # .env.local'ı doldurun, ardından: pnpm dev                   ║
# ║                                                                  ║
# ║  GÜVENLİK: .env.local GİTİGNORE'DA. Asla commit etmeyin.        ║
# ╚══════════════════════════════════════════════════════════════════╝


# ──────────────────────────────────────────────────────────────────
# UYGULAMA
# ──────────────────────────────────────────────────────────────────

# Uygulamanın dış URL'i (Vercel deploy'da otomatik gelir)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ──────────────────────────────────────────────────────────────────
# OKX — CANLI HESAP (LIVE)
# API Management → https://www.okx.com/account/my-api
# İzinler: Read + Trade (IP kısıtlaması önerilir)
# ──────────────────────────────────────────────────────────────────

OKX_API_KEY=your_live_api_key_here
OKX_API_SECRET=your_live_api_secret_here
OKX_API_PASSPHRASE=your_live_api_passphrase_here


# ──────────────────────────────────────────────────────────────────
# OKX — DEMO HESAP (SHADOW / Paper Trading)
# Demo API Management → https://www.okx.com/demo-trading/account/my-api
# EXECUTION_MODE=SHADOW iken bu credentials kullanılır.
# ──────────────────────────────────────────────────────────────────

OKX_DEMO_API_KEY=your_demo_api_key_here
OKX_DEMO_API_SECRET=your_demo_api_secret_here
OKX_DEMO_API_PASSPHRASE=your_demo_api_passphrase_here


# ──────────────────────────────────────────────────────────────────
# OPERASYOn MODU
# SHADOW → OKX Demo hesabı, gerçek kapital riski yok
# LIVE   → OKX Canlı hesap, gerçek işlem
# ──────────────────────────────────────────────────────────────────

EXECUTION_MODE=SHADOW


# ──────────────────────────────────────────────────────────────────
# STATE ŞİFRELEME ANAHTARI
# AES-256-GCM ile localStorage şifrelemesi için sunucu tarafı anahtar.
# Üretmek için: openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────

STATE_ENCRYPTION_KEY=replace_with_output_of__openssl_rand_-base64_32


# ──────────────────────────────────────────────────────────────────
# TELEGRAM BİLDİRİM HATTI
# Bot oluşturma: https://t.me/BotFather → /newbot
# Chat ID: gruba botu ekle, https://api.telegram.org/bot<TOKEN>/getUpdates
# Grup ID'si genellikle "-100" ile başlar.
# ──────────────────────────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_VIP_CHAT_ID=-1001234567890


# ──────────────────────────────────────────────────────────────────
# OKX WEBSOCKET (opsiyonel ince ayar)
# Boş bırakılırsa varsayılanlar kullanılır.
# ──────────────────────────────────────────────────────────────────

# İzlenecek enstrümanlar (virgülle ayrılmış OKX instrument ID)
# OKX_INSTRUMENTS=BTC-USDT-SWAP,ETH-USDT-SWAP

# WebSocket ping aralığı (ms) — varsayılan: 25000
# OKX_PING_INTERVAL_MS=25000
